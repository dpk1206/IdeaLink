<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <title>아이디어 상세</title>
  <link rel="stylesheet" href="/stylesheets/idea_detail.css">
  
</head>

<body>
  <%- include ('header.ejs') %>
  <%
  <!-- 날짜 형식 만들기 -->
  function formatDate(dateString) {
    const date = new Date(dateString);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    const hours = String(date.getHours()).padStart(2, "0");
    const minutes = String(date.getMinutes()).padStart(2, "0");
    return `${year}-${month}-${day} ${hours}:${minutes}`;
  }
%>
<!-- 전체 컨테이너 -->
<main class="detail_container">
  <!-- 왼쪽 광고 -->
  <aside class="ad_banner left_banner">
    <div class="ad_box">광고 영역 (좌)</div>
  </aside>

    <main class="detail_wrap">
      <div class="detail_card">
        <h1 id="idea_title">
          <button 
            id="bookmarkBtn"
            class="bookmark-btn <%= bookmark ? 'active' : '' %>"
            title="북마크"
            onclick="toggleBookmark('<%= user.user_id %>', '<%= postInfo.post_id %>')"
            type="button"
          >
            <span class="star">
              <%= bookmark ? '★' : '☆' %>
            </span>
          </button>
          <%= postInfo.title %>
          <!-- FIXME 본 게시물 채팅 버튼 -->
          <% if(postInfo.user_id != user.user_id) { %>
          <button class="chatBtn"
            onclick="chatBtn('<%= user.user_id %>', '<%= postInfo.user_id %>', '<%= postInfo.post_id %>', 'post')"
            type="button">1:1채팅</button>
            <% } %>
            <!-- 본 게시물 채팅 버튼 end-->
        </h1>
        <div class="meta">
          <span id="author">작성자 : <%=postInfo.nick_name %></span>
          <span id="date">작성일 : <%= formatDate(postInfo.created_at) %></span>
          <span id="views">조회수 : <%=postInfo.view_count %></span>
        </div>

        <div class="tags">
          <span class="tag">거래유형: <strong id="deal_type"><%=postInfo.status %></strong></span>
          <span class="tag">카테고리: <strong id="category">
            <%=postInfo.main_name %> > <%=postInfo.sub_name %>
          </strong></span>
          <span class="tag">가격: <strong id="price"><%=postInfo.price.toLocaleString() %>원</strong></span>
          <span class="tag">파일유형: <strong id="file_type">
            <%
              // fileType 배열 선언 및 플래그 변수
              var fileType = [];
              var hasImage = false;
              var hasDoc = false;

              if (files && files.length > 0) {
                files.forEach(function(file) {
                  var ext = file.saved_name.split('.').pop().toLowerCase();

                  if (!hasImage && (ext === 'jpg' || ext === 'png' || ext === 'gif')) {
                    fileType.push('이미지');
                    hasImage = true;
                  }
                  if (!hasDoc && ext === 'pdf') {
                    fileType.push('문서');
                    hasDoc = true;
                  }
                });
              }else{
                fileType.push('X');
              }
            %>
            <!-- fileType 배열 출력 -->
            <% fileType.forEach(function(type) { %>
              <%= type %>
            <% }); %>
            </strong></span>
        </div>

        <section class="summary">
          <h3>요약</h3>
          <p id="summary_text"><%=postInfo.summary %></p>
        </section>

        <section class="description">
          <h3>본문</h3>
          <p id="description_text"><%- postInfo.content.replace(/\r\n|\n|\r/g, '<br>') %></p>
          <% if (files && files.length > 0) { %>
            <% files.forEach(function(file) { %>
              <% 
                var ext = file.saved_name.split('.').pop().toLowerCase();
              %>
              <% if (ext === 'jpg' || ext === 'png' || ext === 'gif') { %>
                  <img src="/wm_uploads/wm_<%= file.saved_name %>" alt="Image" style="max-width: 100%; height: auto;">
              <% } %>
            <% }); %>
          <% } %>
        </section>

        <!-- 본 게시물 첨부파일 있으면 형성 -->
        <% if (files && files.length > 0) { %>
        <section class="attachments">
          <h3>첨부파일</h3>
          <div id="file_container">
              <% files.forEach(function(file) { %>
                <% 
                  var ext = file.saved_name.split('.').pop().toLowerCase();
                %>
                <% if (ext === 'jpg' || ext === 'png' || ext === 'gif') { %>
                  <div class="file_thumbnail">
                  <a href="/post/download/<%= file.watermark_id %>" download>
                    <img src="/wm_uploads/wm_<%= file.saved_name %>" alt="첨부이미지" class="file_image">
                    <span><%= file.original_name %></span>
                  </a>
                  </div>
                <% } else if (ext === 'pdf') { %>
                  <div class="file_thumbnail">
                    <a href="/post/download/<%= file.watermark_id %>" download><span class="file_icon">📄</span><%= file.original_name %></a>
                  </div>
                <% } %>
              <% }); %>
            </div>
          </section>
          <% } %>
          <!-- 본 게시물 첨부파일 end -->

          <!-- 구매 버튼 -->
          <% if (postInfo.status === '판매' && user && user.user_id !== postInfo.user_id) { %>
            <button id="buyBtn">🛒 구매하기</button>
          <% } else if (postInfo.status === '거래완료') { %>
            <div class="selected-answer-notice" style="color: black;">
              <strong>
              ✅ 거래가 완료된 게시물입니다.
              </strong>
            </div>
          <% } else if (postInfo.status === '거래중') { %>
            <div class="selected-answer-notice" style="background-color: #fff3cd; color: #856404; border-color: #ffc107;">
              <strong>
              ⏳ 현재 거래중인 게시물입니다.
            </strong>
            </div>
          <% } %>




        <!-- 🧾 서약 체크 모달 -->
        <div id="promiseModal" class="modal" style="display: none;">
          <div class="modal-content" style="padding: 30px;">
            <h2 style="margin-bottom: 20px;">📜 아이디어 구매 전 서약</h2>
            <div style="font-size: 14px; line-height: 1.6; background: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid #ccc;">
              <p>본인은 아래의 내용을 충분히 이해하고 이에 동의합니다.</p>
              <ul style="margin-top: 10px; padding-left: 20px;">
                <li>해당 아이디어는 창작자의 창의적인 결과물입니다.</li>
                <li><strong>무단 도용, 복제, 무단 유포 시 민형사상 책임을 질 수 있습니다.</strong></li>
                <li>구매 후에는 환불이 불가능하며, 거래는 아이디어에 대한 열람 권한을 의미합니다.</li>
                <li>아이디어 사용 또는 구현 시 발생하는 책임은 전적으로 본인에게 있습니다.</li>
              </ul>
              <label style="display: block; margin-top: 20px;">
                <input type="checkbox" id="promiseCheck">
                위 서약 내용을 모두 읽고 이해했으며, 이에 동의합니다.
              </label>
            </div>
            <div style="text-align: center; margin-top: 20px;">
              <button id="confirmPromise" style="padding: 10px 20px;">확인하고 계속하기</button>
            </div>
          </div>
        </div>

        <%
          const safeUser = {
            point: typeof user?.point === 'number' ? user.point : Number(user?.point || 0)
          };
          const safePost = {
            title: postInfo?.title || '제목 없음',
            price: Number(postInfo?.price || 0),
            nick_name: postInfo?.nick_name || '알 수 없음'
          };
          const hasEnoughPoint = safeUser.point >= safePost.price;
          const pointColor = hasEnoughPoint ? 'green' : 'red';
        %>

        <!-- 💳 결제 확인 모달 -->
        <div id="paymentModal" class="modal" style="display: none;">
          <div class="modal-content" style="padding: 30px;">
            <h2 style="margin-bottom: 20px;">💳 결제 정보 확인</h2>
            <div style="line-height: 1.6;">
              <p><strong>상품명:</strong> <span id="modal_title"><%= safePost.title %></span></p>
              <p><strong>판매자:</strong> <span id="modal_seller"><%= safePost.nick_name %></span></p>
              <p><strong>결제 금액:</strong> <span id="modal_price" style="color: green; font-weight: bold;"><%= safePost.price.toLocaleString() %>P</span></p>
              <!-- 구매자 입력란 추가 -->
              <p style="margin-top: 10px;">
                <strong>제안할 금액:</strong>
                <input id="input_price" type="number" 
                      value="<%= safePost.price %>" min="1" step="1"
                      style="width: 100px; padding: 4px;" />
                <span style="color: gray;">P</span>
              </p>
              <p><strong>보유 포인트:</strong> <span id="modal_point" style="color: red;"><%= safeUser.point.toLocaleString() %>P</span></p>
            </div>

            <hr style="margin: 20px 0;">

            <% if (hasEnoughPoint) { %>
              <p style="margin-bottom: 10px;">정말 이 아이디어를 구매하시겠습니까?</p>
              <div style="text-align: center; margin-top: 15px;">
                <button id="confirmPurchase" style="padding: 10px 20px; background-color: green; color: white;">✅ 구매 요청</button>
                <button onclick="document.getElementById('paymentModal').style.display='none'" style="padding: 10px 20px;">❌ 취소</button>
              </div>
            <% } else { %>
              <p style="color: red;">⚠️ 보유 포인트가 부족합니다. 충전 후 다시 시도해주세요.</p>
              <div style="text-align: center; margin-top: 15px;">
                <button onclick="window.location.href='/mypage/charge_point'" style="padding: 10px 20px; background-color: #ffc107;">💰 포인트 충전하기</button>
                <button onclick="document.getElementById('paymentModal').style.display='none'" style="padding: 10px 20px;">❌ 닫기</button>
              </div>
            <% } %>
          </div>
        </div>


          
        <div class="actions">
          <button id="like_btn">👍 좋아요 (<span id="like_count">0</span>)</button>
          <button class="answer_action">💬 댓글</button>
          <button class="answer_btn">🗣️ 답글 작성</button>
          <button id="report_btn">🚩 신고</button>
        </div>
        <div class="comment_section">
          <h2>💬 댓글</h2>
          <ul id="comment_list"></ul>
          <textarea id="comment_input" placeholder="댓글을 입력하세요"></textarea>
          <button id="comment_submit">등록</button>
        </div>
      </div>

      <!-- 답글 작성 폼(버튼 추가후 클릭해야 보이게 바꾸기) -->
      <div class="submit_container" style="display: none;">
      <h1>답글 작성</h1>
      <form id="idea_form" action="/post/submit_answer" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="post_id" value="<%= postInfo.post_id %>">
        <input type="hidden" id="answer_user_id" name="answer_user_id" value="<%= user.user_id %>"> <!-- js에서 설정 -->
        <div class="form_card">
          <label for="title">제목</label>
          <input type="text" id="title" name="title" placeholder="답글 제목을 입력하세요" required>
        </div>

        <div class="form_card">
          <label for="description">설명 본문</label>
          <textarea id="description" name="content" placeholder="답글 본문을 입력하세요" required></textarea>
        </div>

        <div class="form_card">
          <label for="price">제안 금액 (P)</label>
          <input type="number" id="price" name="price" placeholder="판매 제안 금액을 입력하세요" required>
        </div>

        <div class="form_card">
          <label>파일 유형 (중복 선택 가능)</label>
          <div class="checkbox_group">
            <label><input type="checkbox" name="file_type" value="image"> 이미지</label>
            <label><input type="checkbox" name="file_type" value="document"> 문서</label>
          </div>
        </div>

        <div class="form_card">
          <label for="files">파일 첨부 (이미지/문서)</label>
          <input type="file" id="files" name="files" accept="image/*, .pdf" multiple>
          <ul id="file_list"></ul>
        </div>

        <button type="submit">제출하기</button>
      </form>
    </div>
    <!-- 답글 작성 폼 end -->

      <!-- 답글 있으면 형성 -->
      <% if (answerInfo && answerInfo.length > 0) { %>
        <% answerInfo.forEach(function(answer) { %>
          <div class="detail_card">
            <% 
            const isSelected = String(postInfo.selected_answer_id) === String(answer.answer_id);
            const isDone = postInfo.status === '거래완료';
            const isProgress = postInfo.status === '거래중';
          %>
          <% if (isSelected && (isDone || isProgress)) { %>
            <div class="selected-answer-notice" style="color: black;">
              ✅ <strong>
                <% if (isDone) { %>
                  거래가 완료된 답변입니다.
                <% } else { %>
                  이 답변은 구매자가 거래 요청한 답변입니다.
                <% } %>
              </strong>
            </div>
          <% } %>

            <h1 id="answer_title">Ⓐ <%= answer.title %>
            <!-- FIXME 답글 채팅 버튼 -->
          <% if(answer.user_id != user.user_id) { %>
          <button class="chatBtn"
            onclick="chatBtn('<%= user.user_id %>', '<%= answer.user_id %>', '<%= answer.answer_id %>', 'answer')"
            type="button">1:1채팅</button>
            <% } %>
            <!-- 답글 채팅 버튼 end-->
            </h1>
            <div class="meta">
              <span id="answer_author">작성자 : <%= answer.nick_name %></span>
              <span id="answer_date">작성일 : <%= formatDate(answer.created_at) %></span>
            </div>

            <section class="description">
              <% if (answer.price) { %>
              <p><strong>💰 제안 금액:</strong> <%= answer.price.toLocaleString() %>P</p>
            <% } %>
              <h3>답변 본문</h3>          
              <p id="answer_content"><%- answer.content.replace(/\r\n|\n|\r/g, '<br>') %></p>
            </section>
            
            <!-- 답글 첨부파일 있으면 형성 -->
            <% if (answer.files && answer.files.length > 0) { %>
            <section class="attachments">
              <h3>첨부파일</h3>
              <div id="file_container">
                  <% answer.files.forEach(function(file) { %>
                    <% 
                      var ext = file.saved_name.split('.').pop().toLowerCase();
                    %>
                    <% if (ext === 'jpg' || ext === 'png' || ext === 'gif') { %>
                      <div class="file_thumbnail">
                      <a href="/post/download/<%= file.watermark_id %>" download>
                        <img src="/wm_uploads/wm_<%= file.saved_name %>" alt="첨부이미지" class="file_image">
                        <span style="margin-bottom: 40px;"><%= file.original_name %></span>
                      </a>
                      </div>
                    <% } else if (ext === 'pdf') { %>
                      <div class="file_thumbnail">
                        <a href="/post/download/<%= file.watermark_id %>" download><span class="file_icon">📄</span><%= file.original_name %></a>
                      </div>
                    <% } %>
                  <% }); %>
                </div>
              </section>
              <% } %>
              <!-- 답글 첨부파일 end -->
              <div class="actions">
                <button class="answer_action">💬 댓글</button>
                <button id="report_btn">🚩 신고</button>
                <button class="answer_action">👍 채택</button>

                <!-- 답글 구매 버튼 조건 -->
              <% if (
                postInfo.status === '구매' &&
                user &&
                user.user_id === postInfo.user_id &&      // 게시글 작성자(구매자)
                user.user_id !== answer.user_id           // 답글 작성자는 아니어야 함
              ) { %>
                <form method="POST" action="/post/request_answer_purchase">
                  <input type="hidden" name="post_id" value="<%= postInfo.post_id %>">
                  <input type="hidden" name="answer_id" value="<%= answer.answer_id %>">
                <button type="button" class="buy_answer_btn"
                  data-answer-id="<%= answer.answer_id %>"
                  data-post-id="<%= postInfo.post_id %>"
                  data-price="<%= answer.price %>"
                  data-seller-name="<%= answer.nick_name %>">
                  🛒 구매 요청
                </button>

                </form>
              <% } %>
              </div>

          </div>
        <% }); %>
      <% } %>
      <!-- 답글 있으면 형성 end -->

    </main>
    <!-- 메인 섹션 랩 end -->

     <!-- 오른쪽 광고 -->
    <aside class="ad_banner right_banner">
      <div class="ad_box">광고 영역 (우)</div>
    </aside>

    </main>
    <!-- 전체 컨테이너 end -->
    <%- include ('footer.html') %>
    <script>
      const currentUserId = "<%= user?.user_id || '' %>";
    </script>
      <script src="/javascripts/idea_detail.js"></script>
</body>

</html>