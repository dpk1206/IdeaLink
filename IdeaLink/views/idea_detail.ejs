<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <title>아이디어 상세</title>
  <link rel="stylesheet" href="/stylesheets/idea_detail.css">
</head>

<body>
  <%- include ('header.ejs') %>

    <main class="detail_wrap">
      <div class="detail_card">
        <h1 id="idea_title"></h1>
        <div class="meta">
          <span id="author"></span>
          <span id="date"></span>
          <span id="views"></span>
        </div>

        <div class="tags">
          <span class="tag">거래유형: <strong id="deal_type"></strong></span>
          <span class="tag">카테고리: <strong id="category"></strong></span>
          <span class="tag">가격: <strong id="price"></strong></span>
          <span class="tag">파일유형: <strong id="file_type"></strong></span>
        </div>

        <section class="summary">
          <h3>요약</h3>
          <p id="summary_text"></p>
        </section>

        <section class="description">
          <h3>본문</h3>
          <p id="description_text"></p>
        </section>

        <section class="attachments">
          <h3>첨부파일</h3>
          <div id="file_container"></div>
        </section>

        <div class="actions">
          <button id="like_btn">👍 좋아요 (<span id="like_count">0</span>)</button>
          <button id="report_btn">🚩 신고</button>
        </div>
      </div>

      <div class="comment_section">
        <h2>💬 댓글</h2>
        <ul id="comment_list"></ul>
        <textarea id="comment_input" placeholder="댓글을 입력하세요"></textarea>
        <button id="comment_submit">등록</button>
      </div>
    </main>
    <%- include ('footer.html') %>
      <script src="/javascripts/idea_detail.js"></script>
</body>

</html>