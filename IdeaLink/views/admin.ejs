<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <title>관리자 페이지</title>
  <link rel="stylesheet" href="/stylesheets/admin.css">
</head>

<body>
  <%- include ('header.ejs') %>
    <div class="admin-container">
    <!-- 사이드 메뉴 -->
    <aside class="admin-sidebar">
      <button onclick="showSection('posts')">📦 전체 아이디어</button>
      <button onclick="showSection('suggestions')">💬 건의사항</button>
      <button onclick="showSection('reports')">🚨 신고글</button>
      <button onclick="showSection('notices')">📢 공지사항</button>
      <button onclick="showSection('adminLogs')">🧾 관리자 로그</button>
      <button onclick="showSection('userLogs')">🧑‍💻 유저 활동</button>
      <button onclick="showSection('userOnline')">🟢 접속 유저</button>
      <button onclick="showSection('pointLogs')">💰 포인트 내역</button>
      <button onclick="showSection('dashboard')">사이트 통계 대시보드</button>
    </aside>

    <!-- 콘텐츠 -->
    <main class="admin-content">
      <!-- 전체 게시글 (판매/구매글) 섹션 -->
        <section id="posts" class="admin-section" style="display:block;">
          <h2>📦 전체 아이디어 / 판매 / 구매글</h2>

          <!-- ✅ 필터 버튼 -->
          <div class="filter-area">
            <button onclick="filterPosts('전체')">전체</button>
            <button onclick="filterPosts('판매')">판매글</button>
            <button onclick="filterPosts('구매')">구매글</button>
            <button onclick="filterPosts('거래중')">거래중</button>
            <button onclick="filterPosts('거래완료')">거래완료</button>
            <button onclick="filterPosts('숨김')">숨김</button>
            <button onclick="filterPosts('중복')">중복</button>
            <button onclick="filterPosts('삭제')">삭제</button>
            <button onclick="filterPosts('검토중')">검토중</button>
            <button onclick="filterPosts('신고누적')">신고누적</button>
            <button onclick="filterPosts('비활성화')">비활성화</button>
          </div>

          <!-- ✅ 게시글 목록 -->
    <% posts.forEach(post => { %>
    <div class="post-box"
      data-type="<%= post.type %>"
      data-status="<%= post.status %>"
      style="border: 1px solid #ccc; padding: 15px; margin: 15px 0;">


        <h3 style="cursor: pointer;" onclick="goToPostDetail('<%= post.post_id %>')">
          [<%= post.status %>] <%= post.title %>
        </h3>

        <p>작성자: <%= post.nick_name %> | 등록일: <%= new Date(post.created_at).toLocaleDateString() %></p>
        <p><strong>내용:</strong> <%= post.content %></p>

        <!-- ✅ 게시글 상태 변경 select -->
        <label>게시글 상태 변경:</label>
         <select onchange="event.stopPropagation(); handleStatusChange(event, '<%= post.post_id %>', this.value, 'post', this)">

          <% ['판매','구매','거래중','거래완료','숨김','중복','삭제','검토중','신고누적','비활성화'].forEach(st => { %>
            <option value="<%= st %>" <%= post.status === st ? 'selected' : '' %>><%= st %></option>
          <% }) %>
        </select>


        <!-- ✅ 답글 목록 -->
        <% if (post.answers && post.answers.length > 0) { %>
          <div class="answer-list" style="margin-top: 10px; padding-left: 15px;">
            <strong>💬 답글 목록:</strong>
            <% post.answers.forEach(ans => { 
                const isSelected = post.selected_answer_id === ans.answer_id;
            %>
              <div class="answer-box <%= isSelected ? 'selected-answer' : '' %>" style="border: 1px solid #eee; padding: 8px; margin-bottom: 5px;">
                <p>
                  <strong><%= ans.nick_name %></strong>
                  <% if (post.status === '구매') { %>
                    (<%= 'P: ' + (ans.price ? ans.price.toLocaleString() : '-') %>)
                  <% } %>
                  <% if (isSelected) { %>
                    <span class="selected-badge">✅ 채택됨</span>
                  <% } %>
                </p>
                <p><%= ans.content %></p>
                <p><small><%= new Date(ans.created_at).toLocaleString() %></small></p>

                <!-- ✅ 답글 상태 변경 select -->
                <label>답글 상태 변경:</label>
               <select onchange="event.stopPropagation(); openStatusModal('<%= ans.answer_id %>', this.value, 'answer', this)">

                  <% ['정상','숨김','중복','삭제','검토중','신고누적','비활성화'].forEach(st => { %>
                    <option value="<%= st %>" <%= ans.moderation_status === st ? 'selected' : '' %>><%= st %></option>
                  <% }) %>
                </select>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color: gray;">답글 없음</p>
        <% } %>
      </div>
    <% }) %>
          </section>

      <!-- 건의사항 -->
      <section id="suggestions" class="admin-section">
        <h2>💬 건의사항 관리</h2>
        <div class="filter-area">
          <input type="text" id="searchUser" placeholder="사용자 ID" />
          <input type="date" id="searchDate" />
          <select id="filterCategory">
            <option value="">전체</option>
            <option value="오류">오류</option>
            <option value="제안">제안</option>
            <option value="기타">기타</option>
          </select>
          <button onclick="applySuggestionFilter()">검색</button>
        </div>
        <table class="styled-table">
          <thead><tr><th>사용자</th><th>내용</th><th>날짜</th><th>상태</th><th>답변</th></tr></thead>
          <tbody>
            <tr class="suggestion-row" data-userid="user123" data-date="2025-04-01" data-category="제안">
              <td>user123</td>
              <td>로그인 문제</td>
              <td>2025-04-01</td>
              <td class="status-cell status-wait">답변 대기</td>
              <td>
                <button onclick="openAnswerForm(this)">답변</button>
                <div class="answer-box" style="display:none;">
                  <textarea></textarea>
                  <button onclick="submitAnswer(this)">저장</button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

<!-- 신고글 -->
<section id="reports" class="admin-section" style="display:none;">
  <h2>🚨 신고된 게시글 및 댓글</h2>
  <table class="styled-table">
    <thead>
      <tr>
        <th>신고 ID</th>
        <th>유형</th>
        <th>신고 대상</th>
        <th>신고자</th>
        <th>사유</th>
        <th>상태</th>
        <th>답변</th>
        <th>신고일</th>
        <th>관리</th>
      </tr>
    </thead>
    <tbody>
      <% reports.forEach(r => { %>
        <tr data-reportid="<%= r.report_id %>">
          <td><%= r.report_id %></td>
          <td><%= r.post_id ? "게시글" : "댓글" %></td>
          <td>
            <% if (r.post_id) { %>
              <strong>[게시글]</strong> <%= r.post_title || "삭제된 글" %>
            <% } else { %>
              <strong>[댓글]</strong> <%= r.answer_content || "삭제된 댓글" %>
            <% } %>
          </td>
          <td><%= r.reporter_name %></td>
          <td><%= r.reason %></td>
          <td><%= r.status %></td>
          <td><%= r.reply || "-" %></td>
          <td><%= new Date(r.created_at).toLocaleString() %></td>
       <td>
  <% if (r.status === '대기') { %>
    <button onclick="openReplyModal('<%= r.report_id %>')">답변</button>

    <% if (r.post_id) { %>
      <button onclick="hidePost('<%= r.post_id %>')">게시글 숨기기</button>
    <% } %>

    <% if (r.answer_id) { %>
      <button onclick="hideAnswer('<%= r.answer_id %>')">댓글 숨기기</button>
    <% } %>

  <% } else { %>
    <span>✅ 완료</span>
  <% } %>
</td>

        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<!-- 답변 모달 -->
<div id="replyModal" class="modal" style="display:none;">
  <div class="modal-content">
    <h3>신고 답변</h3>
    <textarea id="replyText" rows="4" style="width:100%;"></textarea>
    <button id="submitReply">답변 등록</button>
    <button onclick="closeReplyModal()">취소</button>
  </div>
</div>




      <!-- 공지사항 -->
      <section id="notices" class="admin-section" style="display:none;">
        <h2>📢 공지사항 관리</h2>
        <div class="notice-form">
          <input type="text" id="noticeTitle" placeholder="공지 제목">
          <textarea id="noticeContent" placeholder="공지 내용"></textarea>
          <button onclick="addNotice()">등록</button>
        </div>
        <table class="styled-table">
          <thead><tr><th>제목</th><th>날짜</th><th>관리</th></tr></thead>
          <tbody id="noticeList">
            <tr><td>점검 안내</td><td>2025-04-01</td><td><button onclick="editNotice(this)">수정</button> <button onclick="deleteNotice(this)">삭제</button></td></tr>
          </tbody>
        </table>
      </section>

      <!-- 관리자 로그 -->
      <section id="adminLogs" class="admin-section" style="display:none;">
        <h2>🧾 관리자 로그</h2>
        <table class="styled-table">
          <thead><tr><th>시간</th><th>관리자</th><th>작업 내용</th></tr></thead>
          <tbody id="logList"></tbody>
        </table>
      </section>

      <!-- 유저 로그 -->
      <section id="userLogs" class="admin-section" style="display:none;">
        <h2>🧑‍💻 유저 활동</h2>
        <table class="styled-table">
          <thead><tr><th>시간</th><th>유저</th><th>활동</th></tr></thead>
          <tbody id="userLogList">
            <tr><td>2025-04-01 10:25</td><td>userA</td><td>아이디어 등록</td></tr>
          </tbody>
        </table>
      </section>

      <!-- 추가: 현재 로그인 유저 -->
      <section id="userOnline" class="admin-section" style="display:none;">
        <h2>🟢 현재 로그인 유저</h2>
        <ul class="user-list" id="onlineUsers">
          <!-- JS로 채워짐 -->
        </ul>
      </section>

    <!-- ✅ 포인트 로그 조회 섹션 추가 -->
    <section id="pointLogs" class="admin-section" style="display:none;">
      <div style="margin-bottom: 15px; font-size: 18px; font-weight: bold;">
        🧾 사이트 보유 포인트: <span id="adminTotalPoint">0</span>P
      </div>
      <h2>💰 포인트 사용 내역</h2>
      <div class="filter-area">
        <input type="text" id="searchPointUser" placeholder="사용자 ID" />
        <input type="date" id="searchPointDate" />
        <select id="filterPointType">
          <option value="">전체</option>
          <option value="charge">충전</option>
          <option value="use">사용</option>
          <option value="refund">환불</option>
          <option value="answer_charge">답글 판매</option>
          <option value="answer_use">답글 구매</option>
          <option value="hold_use">에스크로 출금 (구매자)</option>
          <option value="hold_charge">에스크로 입금 (관리자)</option>
          <option value="hold_release">에스크로 출금 (관리자)</option>
          <option value="hold_refund">에스크로 환불</option>
        </select>
        <button onclick="applyPointLogFilter()">검색</button>
      </div>
      <table class="styled-table">
        <thead><tr><th>시간</th><th>유저</th><th>유형</th><th>금액</th><th>설명</th></tr></thead>
        <tbody id="pointLogList">
          <!-- JS로 채워짐 -->
        </tbody>
      </table>
    </section>

    <section id="dashboard" class="admin-section" style="display: none;">
 <h2 class="dashboard-title">📊 사이트 통계 대시보드</h2>

<div class="dashboard-grid">

  <div class="stat-card">
    <h3>💰 총 수익 (수수료)</h3>
    <p id="totalPlatformFee" class="stat-value">로딩 중...</p>
  </div>

  <div class="stat-card">
    <h3>📦 누적 거래 통계</h3>
    <p>누적 거래 요청: <span id="totalRequests" class="stat-count">로딩 중...</span></p>
    <p>누적 거래 완료: <span id="totalCompleted" class="stat-count">로딩 중...</span></p>
  </div>

</div>

<div class="dashboard-section">
  <h3>📆 월간 거래 건수</h3>
  <table id="monthlyTradeTable" class="data-table">
    <thead>
      <tr><th>월</th><th>거래 요청</th><th>거래 완료</th></tr>
    </thead>
    <tbody></tbody>
  </table>
</div>

<div class="dashboard-section">
  <h3>📆 월간 수익 (수수료)</h3>
  <table id="monthlyFeeTable" class="data-table">
    <thead>
      <tr><th>월</th><th>수익 (P)</th></tr>
    </thead>
    <tbody></tbody>
  </table>
</div>

<div class="dashboard-section">
  <h3>📚 카테고리별 거래 순위</h3>
  <table id="categoryStatsTable" class="data-table">
    <thead>
      <tr><th>대분류</th><th>중분류</th><th>거래 완료 수</th></tr>
    </thead>
    <tbody></tbody>
  </table>
</div>

<div class="dashboard-section">
  <h3>📊 월별 거래 완료 차트</h3>
  <canvas id="tradeChart" width="600" height="300"></canvas>
</div>




</section>



    </main>
  </div>
    <%- include ('footer.html') %>
      <script src="/javascripts/admin.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <!-- 공지사항 내용 모달 -->
<div id="noticeModal" class="modal" style="display:none;">
  <div class="modal-content">
    <span class="close" onclick="closeNoticeModal()">&times;</span>
    <h3 id="modalNoticeTitle"></h3>
    <p id="modalNoticeContent" style="white-space: pre-line;"></p>
  </div>
</div>

<div id="statusReasonModal" style="display:none; position:fixed; top:0; left:0; 
  width:100%; height:100%; background:rgba(0,0,0,0.5); 
  justify-content:center; align-items:center; z-index:1000;">
  <div style="background:#fff; padding:20px; border-radius:8px; width:400px; max-width:90%;">
    <h3>상태 변경 사유 입력</h3>
    
    <!-- 여기에 상태 표시 -->
    <p id="selectedStatusText" style="margin: 8px 0; color: #333; font-weight: bold;"></p>

    <textarea id="statusReasonInput" rows="4" style="width:100%;" placeholder="사유를 입력해주세요"></textarea>
    
    <div style="margin-top:12px; text-align:right;">
      <button id="cancelReasonBtn">취소</button>
      <button id="confirmReasonBtn">확인</button>
    </div>
  </div>
</div>


</body>

</html>