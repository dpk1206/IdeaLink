<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>관리자 페이지</title>
  <link rel="stylesheet" href="/stylesheets/nav.css">
  <link rel="stylesheet" href="/stylesheets/admin.css">
</head>
<body>
    <header>
        <nav class="navbar">
          <div class="nav-container">
            <a href="/" class="logo">💡 IdeaLink</a>
            <ul class="nav-links">
              <li><a href="/">홈</a></li>
              <li><a href="ideas.html">아이디어 목록</a></li>
              <li><a href="notice.html">공지사항</a></li>
              <li><a href="mypage.html">마이페이지</a></li>
            </ul>
            <div class="hamburger">☰</div>
          </div>
        </nav>
      </header>
  <div class="admin-container">
    <h1>🔧 관리자 페이지</h1>

    <!-- 📌 신고된 게시글 관리 -->
    <section class="report-section">
      <h2>🚨 신고된 게시글</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>번호</th>
            <th>제목</th>
            <th>작성자</th>
            <th>신고 사유</th>
            <th>처리</th>
          </tr>
        </thead>
        <tbody id="reportList">
          <!-- 예시 행 -->
          <tr>
            <td>1</td>
            <td>스팸 아이디어 제목</td>
            <td>user01</td>
            <td>광고성 게시물</td>
            <td>
              <button class="delete-btn">삭제</button>
              <button class="ignore-btn">무시</button>
            </td>
          </tr>
        </tbody>
      </table>
    </section>
    <!-- ✉️ 건의사항 보기 -->
<section class="suggestion-section">
    <h2>✉️ 사용자 건의사항</h2>
    <table class="admin-table">
        <thead>
            <tr>
              <th>번호</th>
              <th>내용</th>
              <th>제출일</th>
              <th>처리</th>
            </tr>
          </thead>
      <tbody id="suggestionList">
        <!-- JS로 채워짐 -->
      </tbody>
    </table>
  </section>

    <!-- 📢 공지사항 작성 -->
    <section class="notice-section">
      <h2>📢 공지사항 작성</h2>
      <form id="noticeForm">
        <label>제목<input type="text" id="noticeTitle" required></label>
        <label>내용<textarea id="noticeContent" rows="5" required></textarea></label>
        <button type="submit">공지 등록</button>
      </form>
    </section>
  </div>

  <script src="/javascripts/nav.js"></script>
  <script src="/javascripts/admin.js"></script>
</body>
</html>
