<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>1:1 채팅</title>
    <link rel="stylesheet" href="/stylesheets/chat.css">
</head>

<body>
    <%
        function formatFileSize(bytes) {
            if (bytes >= 1024 * 1024) {
                return (bytes / (1024 * 1024)).toFixed(1) + "MB";
            } else if (bytes >= 1024) {
                return (bytes / 1024).toFixed(1) + "KB";
            } else {
                return bytes + "B";
            }
        }
    %>
    <div class="chat-container">
            <div class="chat-header" id="chatRoomTitle"><%= title %></div>
            <% const userId=user.user_id %>
                <div class="chat-messages" id="chatMessages">
                <% 
                    let unreadMarkShown = false;
                    messages.forEach(msg => { 
                    // 내 메시지가 아니고, 읽지 않은 메시지(is_read == 0)를 처음 만났을 때
                    if (!unreadMarkShown && msg.sender_id != userId && msg.is_read == 0) { 
                %>
                    <div class="unread-mark" style="text-align:center; color:#888; margin:10px 0;">
                        여기까지 읽으셨습니다.
                        <hr>
                    </div>
                <% 
                        unreadMarkShown = true; 
                    } 
                %>
                    <div 
                    class="message <%= msg.sender_id === userId ? 'mine' : 'other' %>" 
                    data-message-id="<%= msg.message_id %>">
                    <% if (msg.file_type == '.pdf') { %>
                        <div class="file-box">
                            <div class="file-name">▶ <%= msg.original_name %>
                            </div>
                            <div class="file-size">용량: <%= formatFileSize(msg.file_size) %></div>
                            <div class="file-actions">
                                <a href="/post/download/<%= msg.watermark_id %>" download>다운로드⬇️</a>
                            </div>
                        </div>
                        <% } else if (msg.file_type === '.jpg' || msg.file_type === '.png' || msg.file_type === '.gif') { %>
                            <img onclick = "openImageModal(this, '<%= msg.watermark_id %>')" src="/wm_uploads/wm_<%= msg.saved_name %>" alt="첨부 이미지" class="message-image" />
                    <% } %>
                    <%= msg.content %>
                    <% if (msg.is_read == 1) { %>
                        <span class="message-status" data-is-read="1">✔️읽음</span>
                    <% } else { %>
                        <span class="message-status" data-is-read="0">🔵읽지 않음</span>
                    <% } %>
                    <br>
                    <small><%= msg.created_at.toLocaleString() %></small>
                    </div>
                <% }) %>
                </div>
        
        <div class="chat-input-area">
            <form id="chat-form">
                <label class="file-btn">
                    [+]
                    <input type="file" id="fileInput"/>
                </label>
                <div id="filePreview" class="file-preview"></div>
                <input type="text" id="message-input" placeholder="메시지를 입력하세요..." autocomplete="off" />
                <button type="submit" class="send-btn" id="sendBtn">전송</button>
            </form>
        </div>
        
        
    </div>

    <!-- 이미지 확대 모달 -->
    <div id="imageModal" class="image-modal">
        <span id="modalClose">&times;</span>
        <img id="modalImage" class="modal-content" />
        <a id="downloadBtn" class="download-btn" download>⬇️</a>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const user_id = '<%= user.user_id %>';
        const receiver_id = '<%= receiver_id %>';
        const chatting_room_id = '<%= chatting_room_id %>';
        // 두 값이 없으면 에러 페이지로 이동
        if (user_id == '' || receiver_id == '') {
            window.location.href = "/error";
        }
    </script>
    <script src="/javascripts/chat.js"></script>
</body>

</html>