<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>아이디어 등록</title>
  <link rel="stylesheet" href="/stylesheets/submit_idea.css" />
</head>
<body>
  <%- include ('header.ejs') %>
  <!-- 전체 레이아웃 래퍼 -->
  <div class="layout_wrap">
    <!-- 왼쪽 사이드: 작성 가이드 -->
    <aside class="left_sidebar">
      <div class="guide_box">
        <h3>작성 가이드</h3>
        <ul>
          <li>제목은 명확하고 간결하게</li>
          <li>요약은 핵심 내용을 <br>1~2줄로 정리</li>
          <li>본문은 구체적인 문제 해결 방식 위주</li>
          <li>파일은 5개 첨부 가능 파일당 최대 5MB</li>
          <li>첨부가능한 파일 형식은 PDF, 이미지</li>
          <li>중복 내용 없이 독창성 강조</li>
        </ul>
      </div>
    </aside>

    <!-- 메인 콘텐츠 -->
    <main class="submit_container">
      <h1>아이디어 제출</h1>
      <form id="idea_form" action="/post/submit_idea" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="user_id" value="<%= user.user_id %>">
        <div class="form_card">
          <label for="title">제목</label>
          <input type="text" id="title" name="title" placeholder="아이디어 제목을 입력하세요" required>
        </div>

        <div class="form_card">
          <label for="summary">요약</label>
          <input type="text" id="summary" name="summary" maxlength="100" placeholder="100자 이내 요약" required>
        </div>

        <div class="form_card">
          <label for="description">설명 본문</label>
          <textarea id="description" name="content" placeholder="아이디어에 대한 자세한 설명을 입력하세요" required></textarea>
        </div>

        <div class="form_card">
          <label>파일 유형 (중복 선택 가능)</label>
          <div class="checkbox_group">
            <label><input type="checkbox" name="file_type" value="image"> 이미지</label>
            <label><input type="checkbox" name="file_type" value="document"> 문서</label>
          </div>
        </div>

        <div class="form_card">
          <label for="files">파일 첨부 (이미지/문서)</label>
          <input type="file" id="files" name="files" accept="image/*, .pdf" multiple>
          <ul id="file_list"></ul>
        </div>

        <div class="form_card">
          <label>대분류</label>
          <div id="main_category_group" class="category_buttons"></div>
        </div>

        <div class="form_card">
          <label for="sub_category">중분류</label>
          <select id="sub_category" name="sub_category" required>
            <option value="">선택</option>
            <!-- category_id는 js 112줄에서 만들어짐 -->
          </select>
        </div>
        <div class="form_card">
          <label>거래유형</label>
          <div class="radio_group">
            <label><input type="radio" name="transaction_type" value="판매" required> 판매</label>
            <label><input type="radio" name="transaction_type" value="구매"> 구매</label>
          </div>
        </div>

        <div class="form_card" id="price_box">
          <label for="price">가격 (₩)</label>
          <input type="number" id="price" name="price" min="0" placeholder="가격을 입력하세요">
        </div>

        <button type="submit">제출하기</button>
      </form>
    </main>

    <!-- 오른쪽 사이드: 인기 키워드 -->
    <aside class="right_sidebar">
      <div class="keyword_box">
        <h3>인기 키워드</h3>
        <div class="tag_list" id="tag_list"></div>
      </div>
    </aside>
  </div>
  <%- include ('footer.html') %>
  <script src="/javascripts/submit_idea.js"></script>
</body>
</html>
