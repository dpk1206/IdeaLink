<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <title>아이디어 등록</title>
  <link rel="stylesheet" href="/stylesheets/nav.css" />
  <link rel="stylesheet" href="/stylesheets/submit_idea.css" />
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="nav-container">
        <a href="index.html" class="logo">💡 IdeaLink</a>
        <ul class="nav-links">
          <li><a href="index.html">홈</a></li>
          <li><a href="ideas.html">아이디어 목록</a></li>
          <li><a href="notice.html">공지사항</a></li>
          <li><a href="mypage.html">마이페이지</a></li>
        </ul>
        <div class="hamburger">☰</div>
      </div>
    </nav>
  </header>

  <div class="container">
    <h1>💡 아이디어 등록</h1>
    <form>
      <!-- 기본 정보 -->
      <div class="filter-box">
        <h3>기본 정보</h3>
        <label>아이디어 제목</label>
        <input type="text" name="title" required />

        <label>아이디어 설명</label>
        <textarea name="description" rows="5" placeholder="아이디어 개요, 해결 방식 등" required></textarea>
      </div>

      <!-- 카테고리 선택 -->
      <div class="filter-box">
        <h3>2차 분류 (카테고리)</h3>
        <div class="category-carousel">
          <div class="arrow" id="category-left">❮</div>
          <div class="category-grid" id="categoryTrack">
            <label><input type="checkbox" name="category" value="생활/주방/육아"> 🏠 생활/주방/육아</label>
            <label><input type="checkbox" name="category" value="패션/잡화/뷰티"> 👗 패션/잡화/뷰티</label>
            <label><input type="checkbox" name="category" value="식자재/식음료"> 🍝 식자재/식음료</label>
            <label><input type="checkbox" name="category" value="의료/건강"> 💊 의료/건강</label>
            <label><input type="checkbox" name="category" value="가전/광학기기"> 📷 가전/광학기기</label>
            <label><input type="checkbox" name="category" value="모바일/게임"> 📱 모바일/게임</label>
            <label><input type="checkbox" name="category" value="기계/에너지"> ⚙️ 기계/에너지</label>
            <label><input type="checkbox" name="category" value="화학/바이오"> 🔬 화학/바이오</label>
            <label><input type="checkbox" name="category" value="전기/전자"> 💡 전기/전자</label>
            <label><input type="checkbox" name="category" value="미디어/컨텐츠"> 🎨 미디어/컨텐츠</label>
            <label><input type="checkbox" name="category" value="사무/서비스"> 🧾 사무/서비스</label>
            <label><input type="checkbox" name="category" value="기타"> 🧩 기타</label>
          </div>
          <div class="arrow" id="category-right">❯</div>
        </div>
      </div>

      <!-- 거래유형 -->
      <div class="filter-box">
        <h3>거래유형</h3>
        <div class="dealtype-group">
          <label class="dealtype-option">
            <input type="radio" name="dealType" value="판매" required> 판매
          </label>
          <label class="dealtype-option">
            <input type="radio" name="dealType" value="구매"> 구매
          </label>
        </div>
      </div>

      <!-- 파일 업로드 -->
      <div class="filter-box">
        <h3>파일 첨부</h3>
        <label>콘텐츠 유형</label>
        <div class="filetype-group">
          <label><input type="checkbox" name="content_type[]" value="document"> 문서</label>
          <label><input type="checkbox" name="content_type[]" value="image"> 이미지</label>
        </div>

        <label>첨부파일 (기획서, 도면 등)</label>
        <input type="file" name="attachments[]" multiple />
      </div>

      <!-- 판매 정보 -->
      <div class="filter-box">
        <h3>판매 정보</h3>
        <label>가격 (₩)</label>
        <input type="number" name="price" required />

        <label><input type="checkbox" name="negotiable" /> 협의 가능</label>

        <label><input type="checkbox" name="copyright_transfer" /> 저작권 양도 포함</label>
      </div>

      <!-- 공개/문의 -->
      <div class="filter-box">
        <h3>공개 및 문의 설정</h3>
        <label>공개 범위</label>
        <select name="visibility" required>
          <option value="">-- 선택하세요 --</option>
          <option value="public">전체 공개</option>
          <option value="summary_only">요약만 공개</option>
          <option value="members_only">로그인 회원만 보기</option>
        </select>

        <label>문의 허용</label>
        <div class="filetype-group">
          <label><input type="checkbox" name="allow_comment" checked /> 댓글</label>
          <label><input type="checkbox" name="allow_email" /> 이메일</label>
          <label><input type="checkbox" name="allow_message" /> 쪽지</label>
        </div>
      </div>

      <label>태그 (쉼표로 구분)</label>
      <input type="text" name="tags" placeholder="예: 주방, 편의성, 실용신안" />

      <div class="submit-button">
        <button type="submit">✅ 아이디어 등록하기</button>
      </div>
    </form>
  </div>

  <script src="/javascripts/nav.js"></script>
  <script src="/javascripts/submit_idea.js"></script>
</body>
</html>
