<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8" />
  <title>IdeaLink</title>
  <!-- css link -->
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="stylesheet" href="/stylesheets/word.css">
</head>

<body>
  <!-- 헤더 ejs -->
  <%- include ('header.ejs') %>

    <!-- ✅ 메인 페이지 내용 -->
    <div class="wrapper">

      <!-- SECTION 1: 실시간 인기 키워드 -->
      <section class="section keywords-section">
        <div class="container">
          <h2 class="section-title">🔥 실시간 인기 키워드</h2>
          <div id="wordcloud" class="wordcloud"></div>
          <div class="scroll-down-indicator"
            onclick="document.querySelector('.popular-section').scrollIntoView({behavior: 'smooth'})">
            ⬇
          </div>
        </div>
      </section>

      <!-- SECTION 2: 오늘의 인기 아이디어 -->
      <section class="section popular-section">
        <h2 class="section-title">🌟 인기 아이디어</h2>
        <div class="container grid-2col">
          <div class="text-block">
            <h2 id="stat-title" class="section-title">📊아이디어 통계</h2>
            <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon">💡</div>
              <div class="stat-text">등록 아이디어</div>
              <div class="stat-number idea">-</div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">👁️</div>
              <div class="stat-text">전체 조회수</div>
              <div class="stat-number view">-</div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">💬</div>
              <div class="stat-text">받은 피드백</div>
              <div class="stat-number feedback">-</div>
            </div>
          </div>

          <a href="/post/ideas" class="btn">전체 아이디어 보기 →</a>
          </div>
         <div class="card-grid">

  <% if (popularIdeas && popularIdeas.length > 0) { %>
    <% popularIdeas.forEach(idea => { %>
      <div class="idea-card" onclick="location.href='/post/idea_detail?post_id=<%= idea.post_id %>'" style="cursor:pointer;">
        <% if (idea.saved_name) { %>
          <img src="/wm_uploads/wm_<%= idea.saved_name %>" alt="아이디어 이미지">
        <% } else { %>
          <img src="https://placehold.co/600x400?text=No+Image" alt="기본 이미지">
        <% } %>
        <h3><%= idea.title.length > 15 ? idea.title.substring(0, 15) + '...' : idea.title %></h3>
        <p>👤 <%= idea.nick_name || '닉네임 없음' %> <span style="font-weight: 900;">|</span> 👁️ <%= idea.view_count || '조회수 없음' %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>인기 아이디어가 없습니다.</p>
  <% } %>
</div>

      </section>

    <!-- SECTION 3: 공지사항 / FAQ -->
<section class="section notice-faq-section">
  <div class="container">
    <h2 class="section-title">📢 공지사항 / FAQ</h2>
    <div class="grid-2col">

      <!-- ✅ 공지사항 -->
      <div class="notice-column">
        <% if (recentNotices && recentNotices.length > 0) { %>
          <% recentNotices.forEach(notice => { %>
            <div onclick="location.href='/notice'" class="notice-card">
              <h3><%= notice.title %> <span class="date"><%= "(" + notice.formatted_date + ")" %></span></h3>
              <p><%- notice.content.length > 60 ? notice.content.substring(0, 60).replace(/\r\n|\n|\r/g, '<br>') + '...' : notice.content.replace(/\r\n|\n|\r/g, '<br>') %></p>
            </div>
          <% }) %>
        <% } else { %>
          <p>공지사항이 없습니다.</p>
        <% } %>
      </div>

      <!-- ✅ FAQ (고정 아코디언) -->
      <div class="faq-column">
        <div class="accordion-item active">
          <button class="accordion-title">어떤 아이디어를 마켓에 판매할 수 있나요?</button>
          <div class="accordion-content">간단한 아이디어부터 실현 가능한 구체적인 아이디어까지 자유롭게 판매 가능합니다.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-title">전문가는 어떤 기준으로 평가하나요?</button>
          <div class="accordion-content">전문가는 명확성, 참신성, 실현 가능성 등을 기준으로 평가합니다.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-title">내 포인트는 어디서 확인하나요?</button>
          <div class="accordion-content">마이페이지 > 포인트 내역 메뉴에서 확인할 수 있습니다.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-title">내 아이디어가 도용되면 어떡하죠?</button>
          <div class="accordion-content">IdeaLink는 워터마크와 저작권 동의로 도용을 방지합니다.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-title">특허 없이 등록해도 되나요?</button>
          <div class="accordion-content">네, 가능합니다. 등록 기록만으로도 기본적인 보호가 제공됩니다.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-title">아이디어를 구매하면 어떤 권리를 갖게 되나요?</button>
          <div class="accordion-content">구매자는 해당 아이디어의 독점적 사용 권리를 갖습니다.</div>
        </div>
      </div>

    </div>
  </div>
      <!-- 푸터 -->
    <%- include ('footer.html') %>
</section>


    </div> <!-- wrapper 끝 -->

    <!-- js link -->
    <script src="https://cdn.jsdelivr.net/npm/wordcloud@1.2.2/src/wordcloud2.js"></script>
    <script src="/javascripts/main.js"></script>
    <script src="/javascripts/word.js"></script>
</body>

</html>