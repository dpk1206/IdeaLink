<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8" />
  <title>아이디어 거래 플랫폼</title>
  <!-- css link -->
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" type="text/css" href="/stylesheets/jqcloud.min.css" />
</head>

<body>
  <!-- 헤더 ejs -->
  <%- include ('header.ejs') %>

  <!-- 메인 섹션 -->
  <div class="section" id="main">
    <h2>이번 주 아이디어 키워드</h2>
    <div id="wordcloud_div"></div>
    <h1 class="fade-in">💡 IdeaLink</h1>
    <p class="fade-in">아이디어의 가치를 연결하다</p>
    <button onclick="scrollToSection('ideas')" class="fade-in">아이디어 보러가기</button>
  </div>

  <!-- 아이디어 게시판 -->
  <div class="section" id="ideas">
    <h2 class="fade-in">📝 아이디어 게시판</h2>
    <p class="fade-in">다양한 아이디어를 등록하고 탐색해보세요</p>

    <!-- 카테고리 캐러셀 -->
    <div class="category-carousel fade-in">
      <button class="arrow left" onclick="scrollCategories(-1)">&#10094;</button>

      <div class="category-track" id="categoryTrack">
        <div class="category-card category-link" data-category="IT/전자">📱 IT/전자</div>
        <div class="category-card category-link" data-category="생활/주방">🏠 생활/주방</div>
        <div class="category-card category-link" data-category="바이오">🧬 바이오</div>
        <div class="category-card category-link" data-category="콘텐츠">🎨 콘텐츠</div>
        <div class="category-card category-link" data-category="기계/건설">🛠 기계/건설</div>
        <div class="category-card category-link" data-category="의료/방역">💊 의료/방역</div>
        <div class="category-card category-link" data-category="모빌리티">🚗 모빌리티</div>
        <div class="category-card category-link" data-category="에너지">💡 에너지</div>
        <div class="category-card category-link" data-category="물류/유통">📦 물류/유통</div>
        <div class="category-card category-link" data-category="금융/법률">🧾 금융/법률</div>
      </div>

      <button class="arrow right" onclick="scrollCategories(1)">&#10095;</button>
    </div>

    <!-- 워드클라우드 포함 -->
    <!-- 🔥 오늘의 인기 게시글 캐러셀 -->
    <!-- 🔥 오늘의 인기 게시글 캐러셀 섹션 -->
    <div class="popular-carousel-section">
      <h2>🔥 오늘의 인기 게시글</h2>
      <div class="carousel-wrapper">

        <!-- 왼쪽 화살표 (상단과 통일된 클래스) -->
        <div class="arrow category-left">&#10094;</div>

        <!-- 캐러셀 카드 묶음 -->
        <div class="carousel-track">
          <a href="/post/idea_detail?id=1">
            <div class="carousel-card">
              <h4>제로웨이스트 꿀팁</h4>
              <p>실천 가능한 친환경 아이디어</p>
              <span class="views">조회수 412</span>
            </div>
          </a>
          <a href="/post/idea_detail?id=1">
            <div class="carousel-card">
              <h4>미래 도시 설계</h4>
              <p>AI로 스마트시티를 구축하다</p>
              <span class="views">조회수 388</span>
            </div>
          </a>
          <a href="/post/idea_detail?id=1">
            <div class="carousel-card">
              <h4>대학생 창업 아이디어</h4>
              <p>작은 비용으로 시작하는 비즈</p>
              <span class="views">조회수 356</span>
            </div>
          </a>
          <a href="/post/idea_detail?id=1">
            <div class="carousel-card">
              <h4>NFT 활용 전략</h4>
              <p>디지털 자산의 가능성</p>
              <span class="views">조회수 322</span>
            </div>
          </a>
        </div>

        <!-- 오른쪽 화살표 (상단과 통일된 클래스) -->
        <div class="arrow category-right">&#10095;</div>
      </div>
    </div>
  </div>

  <!-- 공지사항 + FAQ -->
  <div class="section notice-faq-section" id="notice">
    <div class="dual-box fade-in">
      <div class="box">
        <a href="/notice"><h2>📢 공지사항</h2></a>
        <ul class="notice-list">
          <li>[03.29] 아이디어 등록 가이드가 업데이트 되었습니다.</li>
          <li>[03.15] 베타 서비스가 시작되었습니다.</li>
        </ul>
      </div>
      <div class="box">
        <a href="/faq"><h2>💬 건의 & FAQ</h2></a>
        <ul class="notice-list">
          <li>자주 묻는 질문을 정리하고 있어요.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- js link -->
  <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3/build/jwt-decode.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/javascripts/jqcloud.min.js"></script>
  <script src="/javascripts/script.js"></script>
  <script>
    document.querySelectorAll('.category-link').forEach(card => {
      card.addEventListener('click', () => {
        const category = card.dataset.category;
        console.log(category);
        location.href = `/post/ideas?category=${encodeURIComponent(category)}`;
      });
    });
  </script>
</body>

</html>