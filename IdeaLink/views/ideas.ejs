<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>아이디어 목록</title>
  <link rel="stylesheet" href="/stylesheets/ideas.css">
</head>
<body>
  <%- include('header.ejs') %>

  <div class="layout-container">
  
    <!-- ✅ 왼쪽 세로 사이드바 그룹 -->
  <div class="left_sidebars">
    <!-- 검색 가이드 사이드바 -->
    <aside class="sidebar">
      <h3>🔍 검색 가이드</h3>
      <ul>
        <li>파일유형 중복 선택 가능</li>
        <li>카테고리 중복 선택 불가능</li>
      </ul>
    </aside>
    <!-- 최근 등록, 인기 아이디어 사이드바 -->
    <aside class="sidebar">
      <h3>🆕 최근 등록</h3>
      <ul id="recent-ideas"></ul>
      <h3>🔥 인기 아이디어</h3>
      <ol id="popular-ideas"></ol>
    </aside>
  </div>
  <!-- 왼쪽 세로 사이드바 그룹 end -->

    <div class="container">
      <a href="/post/submit_idea" class="register-button">+ 아이디어 등록하기</a>
      <h1>📝 아이디어 목록</h1>
      
      
      <!-- 필터 영역 -->
      <div class="filters">
        <!-- 파일유형 선택 -->
        <div class="filter-box">
          <h3>파일 유형</h3>
          <div id="file_type_group" class="category-buttons">
            <button type="button" class="file_type_btn" data-value="문서">문서</button>
            <button type="button" class="file_type_btn" data-value="이미지">이미지</button>
          </div>
        </div>
  
        <!-- 대분류 -->
        <div class="filter-box">
          <h3>대분류</h3>
          <div id="main_category_group" class="category-buttons"></div>
        </div>
  
        <!-- 중분류 -->
        <div class="filter-box">
          <h3>중분류</h3>
          <div id="sub_category_group" class="category-buttons"></div>
        </div>
  
        <!-- 거래유형 -->
        <div class="filter-box">
          <h3>거래 유형</h3>
          <div id="deal_type_group" class="category-buttons">
            <button type="button" class="deal_type_btn <%= selectedTransactionType === 'all' ? 'active' : '' %>" data-value="all">전체</button>
            <button type="button" class="deal_type_btn <%= selectedTransactionType === '판매' ? 'active' : '' %>" data-value="판매">판매</button>
            <button type="button" class="deal_type_btn <%= selectedTransactionType === '구매' ? 'active' : '' %>" data-value="구매">구매</button>
            <button type="button" class="deal_type_btn <%= selectedTransactionType === '거래완료' ? 'active' : '' %>" data-value="거래완료">거래완료</button>
          </div>
        </div>
        <!-- 검색 -->
      <div class="search-box">
      <select id="searchType">
        <option value="title" <%= searchType === 'title' ? 'selected' : '' %>>제목 검색</option>
        <option value="author" <%= searchType === 'author' ? 'selected' : '' %>>작성자 검색</option>
      </select>
      <input type="text" id="searchInput" value="<%= keyword %>" placeholder="검색어 입력">
        <button type="button" onclick="searchIdeas()">검색</button>
        <button id="resetFilters" type="button">초기화</button>
      </div>
      </div>    

      <div class="sort-and-limit-wrapper">
        <!-- 정렬 버튼 -->
        <div class="sort-wrapper">
          <div id="sort_type_group" class="sort-group-center">
            <button type="button" class="sort_type_btn <%= sort_type === 'recent' ? 'active' : '' %>" data-value="recent">최신순</button>
            <button type="button" class="sort_type_btn <%= sort_type === 'popular' ? 'active' : '' %>" data-value="popular">인기순</button>
          </div>
        </div>

        <!-- 표시 개수 -->
        <div class="items-per-page">
          <label for="itemsLimit">표시 개수:</label>
          <select id="itemsLimit">
            <option value="10" <%= limit == 10 ? 'selected' : '' %>>10개</option>
            <option value="20" <%= limit == 20 ? 'selected' : '' %>>20개</option>
            <option value="30" <%= limit == 30 ? 'selected' : '' %>>30개</option>
          </select>
        </div>
      </div>

   <div class="idea-table-wrapper">
  <table class="idea-table">
    <thead>
      <tr>
        <th>번호</th>
        <th>제목</th>
        <th>작성자</th>
        <th>거래유형</th>
        <th>가격</th>
        <th>날짜</th>
        <th>추천수</th>
        <th>조회수</th>
      </tr>
    </thead>
    <tbody id="ideaList">
  <% if (posts && posts.length > 0) { %>
    <% posts.forEach((post, index) => { %>
      
    <tr onclick="window.location.href='/post/idea_detail?post_id=<%= post.post_id %>'" style="cursor:pointer;">
      <td><%= (currentPage - 1) * limit + index + 1 %></td>
      <td><%= post.title %></td>
      <td><%= post.nick_name %></td>
      <td><%= post.status %></td>
      <td><%= post.price.toLocaleString() %></td>
      <td><%= new Date(post.created_at).toLocaleDateString() %></td>
      <td><%= post.like_count ?? 0 %></td>
      <td><%= post.view_count %></td>
    </tr>


    <% }); %>
  <% } else { %>
    <tr><td colspan="7">게시글이 없습니다.</td></tr>  <!-- 게시글이 없을 때 메시지 -->
  <% } %>
</tbody>

  </table>

<% function buildQuery(page, sort = sort_type) { 
  const params = new URLSearchParams();
  if (main_id) params.set("main_id", main_id);
  if (sub_id) params.set("sub_id", sub_id);
  if (file_type) params.set("file_type", file_type);
  if (status && status !== 'all') params.set("status", status);
  if (keyword) {
    params.set("keyword", keyword);
    params.set("search_type", searchType);
  }
  params.set("limit", limit);
  params.set("page", page);
  params.set("sort", sort);
   return `?${params.toString()}#pagination`;
} %>


    <% 
  const pageGroupSize = 5;
  const startPage = Math.floor((currentPage - 1) / pageGroupSize) * pageGroupSize + 1;
  const endPage = Math.min(startPage + pageGroupSize - 1, totalPages);
    %>
    <!--페이징처리-->
    <div id="pagination" class="pagination">
      <% if (totalPages > 1) { %>
        <% if (startPage > 1) { %>
          <a href="<%= buildQuery(startPage - pageGroupSize) %>" class="page-link">이전</a>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
          <% if (i === currentPage) { %>
            <span class="page-number active"><%= i %></span>
          <% } else { %>
            <a href="<%= buildQuery(i) %>" class="page-number"><%= i %></a>
          <% } %>
        <% } %>

        <% if (endPage < totalPages) { %>
          <a href="<%= buildQuery(startPage + pageGroupSize) %>" class="page-link">다음</a>
        <% } %>
      <% } %>
    </div>

    </div>
    </div>
  
    <!-- 오른쪽 광고 배너 -->
    <aside class="sidebar ad_banner right">
        <div class="ad_box">광고 영역</div>
      </aside>
  </div>


  <%- include('footer.html') %>
  
<!-- ✅ 카테고리 매핑 자바스크립트에 전달 -->
<script type="text/javascript">
  const category_main_id_map = JSON.parse(`<%- JSON.stringify(mainCategoryMap || {}).replace(/</g, '\\u003c') %>`);
  const category_sub_id_map = JSON.parse(`<%- JSON.stringify(subCategoryMap || {}).replace(/</g, '\\u003c') %>`);
</script>

<script src="/javascripts/ideas.js"></script>

</body>
</html>
