<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>업로드 성공 후 보여주기 & 다운로드 테스트 페이지</h1>
    <% getFiles.forEach(function(file) { %>
        <% if (file.url.endsWith('.jpg') || file.url.endsWith('.png') || file.url.endsWith('.gif')) { %>
            <a href="/post/download/<%= file.file_id %>"><img src="<%= file.url %>" alt="Image" style="max-width: 100%; height: auto;"></a>
        <% } else if (file.url.endsWith('.pdf')) { %>
            <a href="/post/download/<%= file.file_id %>" download>Download PDF</a>
        <% } %>
    <% }); %>
</body>
</html>