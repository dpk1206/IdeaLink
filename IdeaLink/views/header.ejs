<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/header.css">
</head>
<body>
  <header class="header">
    <div class="header-container">
      <div class="logo">
        <a href="/">💡IdeaLink</a>
      </div>
      <nav class="nav-menu-desktop">
        <a href="/post/ideas">아이디어 게시판</a>
        <a href="#">공모전/전시</a>
        <a href="/notice">공지사항</a>
        <a href="/faq">FAQ&건의</a>
        <% if (user) { %>
          <a href="/users/mypage?user_id=<%= user.user_id %>">☻ <%= user.nick_name %>님</a>
          <a href="/users/logout" id="logoutBtn">로그아웃</a>
        <% } else { %>
          <a href="/login_signup">로그인/회원가입</a>
        <% } %>
      </nav>
      <button class="nav-toggle">☰</button>
    </div>
  </header>
  
  <!-- 모바일 전용 메뉴 모달 -->
  <div class="mobile-menu">
    <div class="mobile-menu-content">
      <button class="close-menu">✕</button>
      <nav class="mobile-nav">
        <a href="/post/ideas">아이디어 게시판</a>
        <a href="#">공모전/전시</a>
        <a href="/notice">공지사항</a>
        <a href="/faq">FAQ&건의</a>
        <% if (user) { %>
          <a href="/users/mypage?user_id=<%= user.user_id %>">☻ <%= user.nick_name %>님</a>
          <a href="/users/logout" id="logoutBtn-mobile">로그아웃</a>
        <% } else { %>
          <a href="/login_signup">로그인/회원가입</a>
        <% } %>
      </nav>
    </div>
  </div>

  <script src="/javascripts/header.js"></script>
</body>
</html>
