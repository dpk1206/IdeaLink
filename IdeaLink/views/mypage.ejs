<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <title>마이페이지</title>
  <link rel="stylesheet" href="/stylesheets/mypage.css">
</head>

<body>
  <%- include ('header.ejs') %>

    <div class="mypage-container">
      <aside class="mypage-sidebar">
        <button class="tab-btn active" data-tab="alerts">🔔 알림</button>
        <button class="tab-btn" data-tab="ideas">💡 등록 아이디어</button>
        <button class="tab-btn" data-tab="history">📑 거래 내역</button>
        <button class="tab-btn" data-tab="chat">💬 채팅방</button>
        <button class="tab-btn" data-tab="profile">👤 회원정보 수정</button>
        <button class="tab-btn" data-tab="suggestions">✉️ 건의사항</button>
      </aside>

      <main class="mypage-content-area">
        <!-- 알림 -->
        <section id="alerts" class="mypage-section">
          <h2>🔔 내 알림</h2>
          <ul class="alert-list" id="alertList"></ul>
        </section>

        <!-- 등록한 아이디어 -->
        <section id="ideas" class="mypage-section" style="display:none;">
          <div class="mypost-tab-menu">
            <button class="mypost-tab-btn active" data-tab="ideas-table">아이디어</button>
            <button class="mypost-tab-btn" data-tab="answer-table">답글</button>
            <button class="mypost-tab-btn" data-tab="comment-table">댓글</button>
          </div>
          <h2>💡 내가 등록한 <span id="post-type">아이디어</span></h2>
          <!-- 게시물 -->
          <table id="ideas-table" class="mypage-table">
            <thead>
              <tr>
                <th>번호</th>
                <th>제목</th>
                <th>가격</th>
                <th>등록일</th>
                <th>조회수</th>
                <th>추천수</th>
                <th>상태</th>
              </tr>
            </thead>
            <tbody>
            <% if (!myPosts || myPosts.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align:center;">작성한 아이디어가 없습니다</td>
              </tr>
            <% } else { %>
              <% myPosts.forEach((post, index) => { %>
                <tr onclick="window.location.href='/post/idea_detail?post_id=<%= post.post_id %>'" style="cursor:pointer;">
                  <td><%= index + 1 %></td>
                  <td><%= post.title %></td>
                  <td><%= post.price.toLocaleString() %>원</td>
                  <td><%= new Date(post.created_at).toISOString().split('T')[0] %></td>
                  <td><%= post.view_count %></td>
                  <td><%= post.recommend %></td>
                  <td class="status-sale"><%= post.transaction_type %></td>
                </tr>
              <% }) %>
            <% } %>
            </tbody>
          </table>

          <!-- 답글 -->
          <table id="answer-table" class="mypage-table" style="display:none;">
            <thead>
              <tr>
                <th>번호</th>
                <th>제목</th>
                <th>등록일</th>
                <th>상태</th>
              </tr>
            </thead>
            <tbody>
            <% if (!myAnswers || myAnswers.length === 0) { %>
              <tr>
                <td colspan="4" style="text-align:center;">작성한 답글이 없습니다</td>
              </tr>
            <% } else { %>
              <% myAnswers.forEach((answer, index) => { %>
                <tr onclick="window.location.href='/post/idea_detail?post_id=<%= answer.post_id %>'" style="cursor:pointer;">
                  <td><%= index + 1 %></td>
                  <td><%= answer.title %></td>
                  <td><%= new Date(answer.created_at).toISOString().split('T')[0] %></td>
                  <td class="status-sale"><%= answer.is_accepted ?? 0 %></td>
                </tr>
              <% }) %>
            <% } %>
            </tbody>
          </table>

          <!-- 댓글 -->
          <table id="comment-table" class="mypage-table" style="display:none;">
            <thead>
              <tr>
                <th>번호</th>
                <th>제목</th>
                <th>카테고리</th>
                <th>등록일</th>
                <th>조회수</th>
                <th>추천수</th>
                <th>상태</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1</td>
                <td>스마트 화분 시스템</td>
                <td>생활/주방</td>
                <td>2024-12-21</td>
                <td>00</td>
                <td>00</td>
                <td class="status-sale">판매중</td>
              </tr>
            </tbody>
          </table>
        </section>

        <section id="history" class="mypage-section" style="display:none;">
          <h2>📑 판매 / 구매 내역</h2>
          <table class="mypage-table">
            <thead>
              <tr>
                <th>거래번호</th>
                <th>유형</th>
                <th>아이디어 제목</th>
                <th>금액</th>
                <th>날짜</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>#A1023</td>
                <td>판매</td>
                <td>스마트 화분 시스템</td>
                <td>₩50,000</td>
                <td>2024-12-22</td>
              </tr>
              <tr>
                <td>#B1094</td>
                <td>구매</td>
                <td>모바일 홈 IoT</td>
                <td>₩75,000</td>
                <td>2024-12-10</td>
              </tr>
            </tbody>
          </table>
        </section>

        <section id="suggestions" class="mypage-section" style="display:none;">
          <h2>✉️ 내 건의사항</h2>
          <table class="mypage-table">
            <thead>
              <tr>
                <th>번호</th>
                <th>내용</th>
                <th>답변</th>
                <th>제출일</th>
              </tr>
            </thead>
            <tbody id="mySuggestionList"></tbody>
          </table>
        </section>

        <section id="chat" class="mypage-section" style="display: none;">
          <h2>💬 참여 중인 채팅방</h2>
          <div class="chat-container">
            <div class="chat-room-list" id="chatRoomList"></div>
            <div class="chat-box">
              <div class="chat-header" id="chatRoomTitle">채팅방</div>
              <div class="chat-messages" id="chatMessages"></div>
              <div class="chat-input-area">
                <input type="text" id="chatInput" placeholder="메시지를 입력하세요..." />
                <button class="send-btn" id="sendBtn">전송</button>
              </div>
            </div>
          </div>
        </section>

        <section id="profile" class="mypage-section" style="display:none;">
          <h2>👤 회원정보 수정</h2>
          <form id="personalForm" style="display: none;">
            <label>닉네임
              <div class="input-check-group">
                <input type="text" id="username" required />
                <button type="button" id="checkUsername">중복 확인</button>
              </div>
            </label>
            <label>비밀번호<input type="password" required /></label>
            <label>이름<input type="text" required /></label>
            <label>이메일<input type="email" required /></label>
            <label>핸드폰 번호<input type="tel" required /></label>
            <button type="submit">정보 수정</button>
          </form>

          <form id="companyForm" style="display: none;">
            <label>회사이름<input type="text" required /></label>
            <label>사업자 등록번호<input type="text" required /></label>
            <label>회사 전화번호<input type="tel" required /></label>
            <label>회사 주소<input type="text" required /></label>
            <label>회사 웹사이트<input type="url" /></label>
            <label>담당자 이메일<input type="email" required /></label>
            <label>비밀번호<input type="password" required /></label>
            <button type="submit">정보 수정</button>
          </form>
        </section>
      </main>
    </div>
    <%- include ('footer.html') %>
      <script src="/javascripts/mypage.js"></script>
</body>

</html>