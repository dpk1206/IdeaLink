<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <title>마이페이지</title>
  <link rel="stylesheet" href="/stylesheets/mypage.css">
</head>

<body>
  <%- include ('header.ejs') %>

    <div class="mypage-container">
      <aside class="mypage-sidebar">
        <button class="tab-btn active" data-tab="alerts">🔔 알림 / 💬 1:1 채팅</button>
        <button class="tab-btn" data-tab="point-charge">💰 포인트</button>
        <button class="tab-btn" data-tab="bookmark">⭐ 북마크</button>
        <button class="tab-btn" data-tab="ideas">💡 등록 아이디어</button>
        <button class="tab-btn" data-tab="requested">📦 구매 요청</button>
        <button class="tab-btn" data-tab="history">📑 거래 내역</button>
        <button class="tab-btn" data-tab="profile">👤 회원정보 수정</button>
      </aside>

      <main class="mypage-content-area">
        <!-- 알림 & 채팅 -->
        <section id="alerts" class="mypage-section">
          <div class="alert-chat-wrapper">
            <div class="alert-list" id="alertList">
              <h2 style="display: flex; justify-content: space-between; align-items: center;">🔔 알림
                <div class="alert-buttons">
                <button id="markAllReadBtn">전체 읽음</button>
                <button id="markAllDeleteBtn">전체 삭제</button>
                </div>
              </h2>
              <% notifications.forEach(noti=> { %>
                <li class="alert-item <%= noti.unreadCount ? '' : 'read' %>">
                  <div class="alert-text"><%= noti.content %>
                    <% if (noti.type==='chat' ) { %>
                      <span class="chat-unread"><%= noti.unreadCount ? ' • ' + noti.unreadCount : '' %></span>
                      <% } %>
                      </div>
                      <div class="chat-meta">
                          🕒 <%= noti.created_at.toLocaleString() %>
                        </div>
                      <div class="alert-buttons">
                        <button class="move-btn"
                          onclick="chatWindow('<%= user.user_id %>', '<%= noti.sender_id %>', '<%= noti.post_id %>', '<%= noti.post_type %>')">이동</button>
                        <button class="read-btn" onclick="markAsRead(this, '<%= noti.notification_id %>', '<%= noti.type %>')"
                          <%=noti.is_read ? 'disabled' : '' %>>읽음</button>
                        <button class="delete-btn" onclick="deleteNotification(this, '<%= noti.notification_id %>', '<%= noti.type %>')">삭제</button>
                        </div>
                </li>
                <% }) %>
            </div>

            <div class="chat-room-list" id="chatRoomList">
              <h2>💬 채팅방</h2>
              <% chattings.forEach(room=> { %>
                <div class="chat-room"
                  onclick="chatWindow('<%= user.user_id %>', '<%= room.partnerId %>', '<%= room.post_id %>', '<%= room.type %>')">
                  <div class="chat-title">
                    <%= room.title %><span class="chat-unread">
                        <%= room.unreadCount ? ' • ' + room.unreadCount : '' %>
                      </span>
                  </div>
                  <div class="chat-meta">
                    👤 <%= room.partner_nickname %> 님과의 대화 | 🕒 <%= room.updated_at.toLocaleString() %>
                  </div>
                  <div class="chat-preview"><%= room.recentMessage %></div>
                </div>
                <% }) %>
          </div>
        </section>

        <!-- 포인트 충전 + 사용 내역 -->
        <section id="point-charge" class="mypage-section" style="display: none;">
          <h2>💰 포인트</h2>
          <p>현재 보유 포인트: <strong>
              <%= userInfo.point.toLocaleString() %>P
            </strong></p>

          <!-- 충전 폼 -->
          <form id="payForm" style="margin-top: 10px;">
            <input type="hidden" id="sellerId" value="<%= userInfo.user_id %>">
            <input type="hidden" id="title" value="포인트 충전">
            <input type="number" id="amount" placeholder="충전 금액 (원)" min="1000" step="500" required
              style="padding: 5px;">
            <button type="submit" style="padding: 5px 10px;">충전하기</button>
          </form>

        <!-- 포인트 사용 내역 -->
        <div style="margin-top: 30px;">
          <h3>📜 포인트 사용 내역</h3>
          <table class="mypage-table">
            <thead>
              <tr>
                <th>날짜</th>
                <th>유형</th>
                <th>금액</th>
                <th>설명</th>
              </tr>
            </thead>
            <tbody>
              <% if (!pointLogs || pointLogs.length === 0) { %>
                <tr>
                  <td colspan="4" style="text-align:center;">포인트 사용 내역이 없습니다</td>
                </tr>
              <% } else { %>
                <% pointLogs.forEach(log => { %>
                  <tr>
                    <!-- 날짜 -->
                    <td><%= new Date(log.created_at).toLocaleString('ko-KR', { hour12: false }) %></td>
                    
                    <!-- 유형 -->
                    <td>
                      <% if (log.type === 'charge' && log.description?.includes('판매')) { %>
                        게시글 판매
                      <% } else if (log.type === 'charge') { %>
                        포인트 충전
                      <% } else if (log.type === 'use') { %>
                        게시글 구매
                      <% } else if (log.type === 'refund') { %>
                        환불
                      <% } else if (log.type === 'answer_charge') { %>
                        답글 판매
                      <% } else if (log.type === 'answer_use') { %>
                        답글 구매
                      <% } else if (log.type === 'hold_use') { %>
                        에스크로 출금 (구매자)
                      <% } else if (log.type === 'hold_charge') { %>
                        에스크로 입금 (관리자)
                      <% } else if (log.type === 'hold_release') { %>
                        에스크로 출금 (관리자)
                      <% } else if (log.type === 'hold_refund') { %>
                        에스크로 환불
                      <% } else { %>
                        -
                      <% } %>
                    </td>

                    <!-- 금액 (부호 포함) -->
                    <td>
                      <% let sign = '+'; %>
                      <% if (['use', 'answer_use', 'hold_use', 'hold_release'].includes(log.type)) { sign = '-'; } %>
                      <%= sign + Math.abs(log.amount).toLocaleString() %>P
                    </td>



                    <!-- 설명 -->
                    <td><%= log.description || '-' %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

        <!-- 북마크 -->
        <section id="bookmark" class="mypage-section" style="display:none;">
          <h2>⭐ 북마크</h2>
          <table class="mypage-table">
            <thead>
              <tr>
                <th>번호</th>
                <th>제목</th>
                <th>작성자</th>
                <th>아이디어 등록일</th>
                <th>조회수</th>
                <th>추천수</th>
                <th>상태</th>
                <th>북마크 등록일</th>
              </tr>
            </thead>
            <tbody>
            <% if (!bookmarks || bookmarks.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align:center;">북마크가 없습니다</td>
              </tr>
            <% } else { %>
              <% bookmarks.forEach((bookmark, index) => { %>
                <tr onclick="window.location.href='/post/idea_detail?post_id=<%= bookmark.post_id %>'" style="cursor:pointer;">
                  <td><%= index + 1 %></td>
                  <td><%= bookmark.title %></td>
                  <td><%= bookmark.nick_name %></td>
                  <td><%= new Date(bookmark.created_at).toISOString().split('T')[0] %></td>
                  <td><%= bookmark.view_count %></td>
                  <td><%= bookmark.like %></td>
                  <td class="status-sale"><%= bookmark.status %></td>
                  <td>
                    <% if (bookmark.bookmark_created_at) { %>
                      <%= new Date(bookmark.bookmark_created_at).toISOString().split('T')[0] %>
                    <% } else { %>
                      -
                    <% } %>
                    <button 
                      class="delete-btn"
                      onclick="toggleDeleteBookmark(event,'<%= user.user_id %>', '<%= bookmark.post_id %>')"
                      style="border:none; background:none; cursor:pointer; margin-left:10px;">
                      ❌
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
          </table>
        </section>

        <!-- 등록한 아이디어 -->
        <section id="ideas" class="mypage-section" style="display:none;">
          <div class="mypost-tab-menu">
            <button class="mypost-tab-btn active" data-tab="ideas-table">아이디어</button>
            <button class="mypost-tab-btn" data-tab="answer-table">답글</button>
            <button class="mypost-tab-btn" data-tab="comment-table">댓글</button>
          </div>
          <h2>💡 내가 등록한 <span id="post-type">아이디어</span></h2>
          <!-- 게시물 -->
          <table id="ideas-table" class="mypage-table">
            <thead>
              <tr>
                <th>번호</th>
                <th>제목</th>
                <th>가격</th>
                <th>제안금액</th> <!-- 추가 -->
                <th>구매자</th> <!-- 추가 -->
                <th>등록일</th>
                <th>조회수</th>
                <th>추천수</th>
                <th>상태</th>
              </tr>
            </thead>
            <tbody>
            <% if (!myPosts || myPosts.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align:center;">작성한 아이디어가 없습니다</td>
              </tr>
            <% } else { %>
              <% myPosts.forEach((post, index) => { %>
                <tr onclick="window.location.href='/post/idea_detail?post_id=<%= post.post_id %>'" style="cursor:pointer;">
                  <td><%= index + 1 %></td>
                  <td><%= post.title %></td>
                  <td><%= post.price?.toLocaleString() %>원</td>
                  <td><%= post.request_price ? post.request_price.toLocaleString() + '원' : '-' %></td> <!-- 제안금액 -->
                  <td><%= post.buyer_nick || '-' %></td> <!-- 구매자 닉네임 -->
                  <td><%= new Date(post.created_at).toISOString().split('T')[0] %></td>
                  <td><%= post.view_count %></td>
                  <td><%= post.like_count %></td>
                  <td class="status-sale">
                  <% const seller_id = seller_id_map[post.post_id]; %>

                  <% if (post.status === '거래중' && seller_id == user.user_id) { %>
                    <!-- 수락 버튼 -->
                    <form method="POST" action="/post/confirm/<%= post.post_id %>" onsubmit="return confirm('정말 거래를 수락하시겠습니까?');" style="display:inline;">
                      <input type="hidden" name="post_id" value="<%= post.post_id %>">
                      <button type="submit" onclick="event.stopPropagation()">수락</button>
                    </form>

                    <!-- 거절 버튼 -->
                    <form method="POST" action="/post/reject/<%= post.post_id %>" onsubmit="return confirm('정말 거래를 거절하시겠습니까?');" style="display:inline; margin-left: 8px;">
                      <input type="hidden" name="post_id" value="<%= post.post_id %>">
                      <button type="submit" onclick="event.stopPropagation()">거절</button>
                    </form>
                  <% } else { %>
                    <%= post.status %>
                  <% } %>
                </td>

                </tr>
              <% }) %>
            <% } %>
            </tbody>
          </table>

          <!-- 답글 -->
          <table id="answer-table" class="mypage-table" style="display:none;">
            <thead>
              <tr>
                <th>번호</th>
                <th>제목</th>
                <th>등록일</th>
                <th>가격</th>
                <th>요청 금액</th>
                <th>상태</th>
              </tr>
            </thead>
            <tbody>
              <% if (!myAnswers || myAnswers.length === 0) { %>
                <tr>
                  <td colspan="4" style="text-align:center;">작성한 답글이 없습니다</td>
                </tr>
              <% } else { %>
                <% myAnswers.forEach((answer, index) => { 
                const target = confirmTargetMap[answer.answer_id]; %>
              <tr onclick="window.location.href='/post/idea_detail?post_id=<%= answer.post_id %>'" style="cursor:pointer;">
              <td><%= index + 1 %></td>
              <td><%= answer.title %></td>
              <td><%= new Date(answer.created_at).toISOString().split('T')[0] %></td>

              <!-- 💰 게시글 가격 -->
              <td>
                <% if (target && target.answer_price) { %>
                  <%= target.answer_price.toLocaleString() %>P
                <% } else { %>
                  -
                <% } %>
              </td>

              <!-- 🙋 요청 금액 -->
              <td>
                <% if (target && target.proposed_price) { %>
                  <%= target.proposed_price.toLocaleString() %>P
                <% } else { %>
                  -
                <% } %>
              </td>


                <!-- 📦 거래 상태 -->
              <td class="status-sale">
              <% if (target) { %>
                <% if (target.isMine && target.status === '거래중') { %>
                  <form method="POST" action="/post/confirm_answer_purchase" style="display:inline;">
                    <input type="hidden" name="post_id" value="<%= target.post_id %>">
                    <input type="hidden" name="answer_id" value="<%= answer.answer_id %>">
                    <button type="submit">수락</button>
                  </form>

                  <form method="POST" action="/post/reject_answer_purchase" style="display:inline; margin-left: 8px;">
                    <input type="hidden" name="post_id" value="<%= target.post_id %>">
                    <input type="hidden" name="answer_id" value="<%= answer.answer_id %>">
                    <button type="submit">거절</button>
                  </form>
                <% } else if (target.status === '거래완료') { %>
                  거래완료
                <% } else { %>
                  <% if (!target.isMine && target.status === '거래중') { %>
                    다른 답변과 거래 진행 중
                  <% } else if (!target.isMine && target.status === '거래완료') { %>
                    거래완료
                  <% } %>
                <% } %>
              <% } else { %>
                대기중
              <% } %>
            </td>

              </tr>
            <% }) %>

              <% } %>
            </tbody>
          </table>


          <!-- 댓글 -->
          <table id="comment-table" class="mypage-table" style="display:none;">
            <thead>
              <tr>
                <th>번호</th>
                <th>내용</th>
                <th>등록일</th>
              </tr>
            </thead>
            <tbody>
              <% if (!myComments || myComments.length===0) { %>
                <tr>
                  <td colspan="3" style="text-align:center;">작성한 댓글이 없습니다</td>
                </tr>
                <% } else { %>
                  <% myComments.forEach((comment, index)=> { %>
                    <tr onclick="window.location.href='/post/idea_detail?post_id=<%= comment.post_id %>'"
                      style="cursor:pointer;">
                      <td>
                        <%= index + 1 %>
                      </td>
                      <td>
                        <%= comment.content %>
                      </td>
                      <td>
                        <%= new Date(comment.created_at).toISOString().split('T')[0] %>
                      </td>
                    </tr>
                    <% }) %>
                      <% } %>
            </tbody>
          </table>
        </section>

        <!-- 📦 구매 요청 (하위 분류 포함) -->
        <section id="requested" class="mypage-section" style="display:none;">
          <h2>📦 내가 구매 요청한 게시글</h2>

          <!-- 일반 게시글 구매 요청 -->
          <h3 style="margin-top: 20px;">🛒 일반 판매 게시글</h3>
          <table class="mypage-table">
            <thead>
              <tr>
                <th>제목</th>
                <th>판매자</th>
                <th>요청일</th>
                <th>내가 요청한 금액</th>
                <th>가격</th>
                <th>상태</th>
              </tr>
            </thead>
            <tbody>
              <% if (!requestedDirectPosts || requestedDirectPosts.length === 0) { %>
                <tr><td colspan="5" style="text-align:center;">요청한 일반 게시글이 없습니다</td></tr>
              <% } else { %>
                <% requestedDirectPosts.forEach(post => { %>
                  <tr onclick="window.location.href='/post/idea_detail?post_id=<%= post.post_id %>'" style="cursor:pointer;">
                    <td><%= post.title %></td>
                    <td><%= post.nick_name %></td>
                    <td><%= new Date(post.created_at).toISOString().split('T')[0] %></td>
                    <td><%= post.proposed_price?.toLocaleString?.() || '-' %>원</td>
                    <td><%= post.price.toLocaleString() %>원</td>
                    <td>
                      <% if (post.request_status === '수락됨') { %>
                        <span style="color: green; font-weight: bold;">거래완료</span>
                      <% } else if (post.request_status === '거절됨') { %>
                        <span style="color: red; font-weight: bold;">거절됨</span>
                      <% } else if (post.request_status === '대기중') { %>
                        <span style="color: orange;">구매 요청중</span>
                      <% } else { %>
                        <%= post.request_status %>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>

          <!-- 답변 기반 구매 요청 -->
          <h3 style="margin-top: 40px;">💬 답변을 통한 구매 요청</h3>
          <table class="mypage-table">
          <thead>
            <tr>
              <th>구매 게시글 제목</th>
              <th>답변 제목</th>
              <th>판매자</th>
              <th>요청일</th>
              <th>제안 금액</th>
              <th>상태</th>
            </tr>
          </thead>
          <tbody>
            <% if (!requestedAnswerPosts || requestedAnswerPosts.length === 0) { %>
              <tr><td colspan="6" style="text-align:center;">요청한 답변 기반 게시글이 없습니다</td></tr>
            <% } else { %>
              <% requestedAnswerPosts.forEach(post => { %>
                <tr onclick="window.location.href='/post/idea_detail?post_id=<%= post.post_id %>'" style="cursor:pointer;">
                  <td><%= post.post_title %></td> <!-- 게시글 제목 -->
                  <td><%= post.answer_title %></td> <!-- 답변 제목 -->
                  <td><%= post.nick_name %></td> <!-- 판매자 닉네임 -->
                  <td><%= new Date(post.created_at).toISOString().split('T')[0] %></td>
                  <td><%= post.proposed_price?.toLocaleString?.() || '-' %>원</td>
                  <td>
                    <% if (post.request_status === '수락됨') { %>
                      <span style="color: green; font-weight: bold;">거래완료</span>
                    <% } else if (post.request_status === '거절됨') { %>
                      <span style="color: red; font-weight: bold;">거절됨</span>
                    <% } else if (post.request_status === '대기중') { %>
                      <span style="color: orange;">구매 요청중</span>
                    <% } else { %>
                      <%= post.request_status %>
                    <% } %>
                  </td>
              </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
        </section>



        <section id="history" class="mypage-section" style="display:none;">
          <h2>📑 판매 / 구매 내역</h2>
          <table class="mypage-table">
            <thead>
              <tr>
                <th>거래번호</th>
                <th>유형 / 방식</th>
                <th>아이디어 제목</th>
                <th>금액</th>
                <th>날짜</th>
              </tr>
            </thead>
            <tbody>
            <% if (!tradeHistory || tradeHistory.length === 0) { %>
              <tr><td colspan="5" style="text-align:center;">거래 내역이 없습니다.</td></tr>
            <% } else { %>
              <% tradeHistory.forEach((t) => { %>
                <tr>
                  <td>#<%= t.post_id %></td>
                  <td>
                    <% if (t.type === '판매' && t.method === '답글거래') { %>
                      답글 / 판매
                    <% } else if (t.type === '판매') { %>
                      게시글 / 판매
                    <% } else if (t.type === '구매' && t.method === '답글거래') { %>
                      답글 / 구매
                    <% } else { %>
                      게시글 / 구매
                    <% } %>
                  </td>
                  <td><%= t.title %></td>
                  <td><%= t.price.toLocaleString() %>원</td>
                  <td><%= new Date(t.date).toISOString().split("T")[0] %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>


          </table>
        </section>

        <section id="chat" class="mypage-section" style="display: none;">
          <h2>💬 참여 중인 채팅</h2>
          <div class="chat-container">
            <div class="chat-room-list" id="chatRoomList"></div>
            <div class="chat-box">
              <div class="chat-header" id="chatRoomTitle">채팅</div>
              <div class="chat-messages" id="chatMessages"></div>
              <div class="chat-input-area">
                <input type="text" id="chatInput" placeholder="메시지를 입력하세요..." />
                <button class="send-btn" id="sendBtn">전송</button>
              </div>
            </div>
          </div>
        </section>

        <!-- 회원정보 수정 -->
        <!-- TODO  
        1. 닉네임등 수정 후 다시로그인 하게 해서 jwt 토큰 새로 발급
        2. 중복확인? 유저 구분 어떻게? 닉네임(이름)?
        3. 비밀번호 변경시 확인란으로 동일한지 체크 필요
        4. 이메일, 전화번호 수정 불가 -> 관리자 문의
         -->
        <section id="profile" class="mypage-section" style="display:none;">
          <h2>👤 회원정보 수정</h2>
          <form id="personalForm" class="form-narrow" style="display: none;">
            <label>닉네임
              <div class="input-check-group">
                <input type="text" id="username" required value="<%= userInfo.nick_name %>" />
                <button type="button" id="checkUsername">중복 확인</button>
              </div>
            </label>
            <label>비밀번호<input type="password" required /></label>
            <label>비밀번호 확인<input type="password" id="confirm_password" class="form-input" required /></label>
            <label>이름<input type="text" disabled value="<%= userInfo.name %>" /></label>
            <label>이메일<input type="email" disabled value="<%= userInfo.email %>" /></label>
            <label>핸드폰 번호<input type="tel" disabled value="<%= userInfo.phone %>" /></label>
            <button type="submit">정보 수정</button>
          </form>

          <form id="companyForm" style="display: none;">
            <label>회사이름<input type="text" required /></label>
            <label>사업자 등록번호<input type="text" required /></label>
            <label>회사 전화번호<input type="tel" required /></label>
            <label>회사 주소<input type="text" required /></label>
            <label>회사 웹사이트<input type="url" /></label>
            <label>담당자 이메일<input type="email" required /></label>
            <label>비밀번호<input type="password" required /></label>
            <button type="submit">정보 수정</button>
          </form>
        </section>
      </main>
    </div>
    <%- include ('footer.html') %>

      <script src="https://js.tosspayments.com/v1"></script>
      <script src="/javascripts/mypage.js"></script>
</body>

</html>